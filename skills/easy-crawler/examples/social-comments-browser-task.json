{
  "task_name": "social-comments-browser-demo",
  "targets": [
    {
      "url": "https://social.example/post/123",
      "page_type": "comments",
      "intent": "extract_comments",
      "requires_js": true
    }
  ],
  "extraction": {
    "record_type": "comment_thread",
    "fields": ["comment_id", "parent_id", "author", "content", "published_at"],
    "pagination": {
      "type": "infinite_scroll",
      "max_pages": 5
    }
  },
  "run": {
    "mode": "browser",
    "output_format": "json",
    "http": {
      "timeout_seconds": 20,
      "user_agent": "easy-crawler/0.2",
      "accept_language": "zh-CN,zh;q=0.9,en;q=0.8",
      "max_redirects": 5
    },
    "browser": {
      "required": true,
      "storage_state_path": "./state/social.json",
      "connect_url": null,
      "stealth": true,
      "headers_profile": "desktop-chrome-zh",
      "attach_to_existing": true
    }
  },
  "social": {
    "platform": "social-feed",
    "search_query": null,
    "creator_handle": null,
    "include_comments": true,
    "include_replies": true,
    "login_state": "required",
    "dynamic_rendering": true,
    "sort": "top",
    "time_scope": "all",
    "entry_hint": "post_detail"
  },
  "anti_bot": {
    "proxy_profile": "rotating-residential",
    "real_browser": true,
    "challenge_handling": "manual_intervention",
    "requires_captcha_solver": false,
    "user_agent_strategy": "rotate",
    "header_profile": "desktop-chrome-zh",
    "rate_limit_window_seconds": 2,
    "preferred_region": "cn-hk"
  },
  "discovery": {
    "strategy": "none",
    "max_discovered_targets": 0,
    "dedupe_by": "record_id",
    "checkpoint_key": "last_comment_id",
    "resume_from_checkpoint": false
  },
  "platform": {
    "requires_signing": false
  },
  "artifacts": {
    "capture_html": true,
    "capture_trace": true,
    "capture_screenshot": true
  }
}
